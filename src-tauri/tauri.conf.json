{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktools",
  "version": "1.0.0",
  "identifier": "com.hyy.desktools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskTools",
        "width": 920,
        "height": 740,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "history",
        "title": "剪贴板历史",
        "url": "index.html?popup=history",
        "width": 460,
        "height": 620,
        "minWidth": 360,
        "minHeight": 320,
        "center": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "files",
        "title": "文件中转站",
        "url": "index.html?popup=files",
        "width": 760,
        "height": 620,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:* ws://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RTkzMzM2Mzk0MEMwRTUKUldUbHdFQTVOalBwMkQxajM4UENNQVlzazBLaWxWTE5KUzdYYVVnc3pSRHArMGEzcTZIT0NCSEgK",
      "endpoints": [
        "https://github.com/240011814/desktools/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}