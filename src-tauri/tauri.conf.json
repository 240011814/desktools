{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktools",
  "version": "1.0.0",
  "identifier": "com.hyy.desktools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeskTools",
        "width": 920,
        "height": 740,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RTkzMzM2Mzk0MEMwRTUKUldUbHdFQTVOalBwMkQxajM4UENNQVlzazBLaWxWTE5KUzdYYVVnc3pSRHArMGEzcTZIT0NCSEgK",
      "endpoints": [
        "https://github.com/240011814/desktools/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}